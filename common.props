<Project>
	<PropertyGroup>
		<RootNamespace />
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Authors>lenfon</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
		<!-- 让 .editorconfig 中的代码风格规则参与命令行构建 -->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- 分析器诊断在构建中生效，避免只在 IDE 中可见 -->
		<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<PropertyGroup>
		<!-- 包元数据：所有可打包项目共用 -->
		<PackageTags>abp;wpf;mvvm;source-generator</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/LenFon/Len.Abp.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/LenFon/Len.Abp</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
