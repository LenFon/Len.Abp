<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageVersion Include="ConfigureAwait.Fody" Version="3.3.2" />
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />
		<PackageVersion Include="MaterialDesignThemes.MahApps" Version="5.3.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<!--
			显式引用代码风格分析器，让命令行构建与 VS 使用同一版本。
			SDK 自带的版本落后于 VS，导致同一段代码在 IDE 里报 IDE0028、在构建里不报。

			分析器要求 Roslyn 5.12，而较旧的 SDK 自带编译器低于该版本，
			版本不匹配时分析器会被静默跳过，因此必须同时升级编译器工具集。
		-->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.12.0" />
		<PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="5.12.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
		<PackageVersion Include="PolySharp" Version="1.15.0" />
		<PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="Volo.Abp.Autofac" Version="10.0.2" />
		<PackageVersion Include="Volo.Abp.BackgroundWorkers" Version="10.0.2" />
		<PackageVersion Include="Volo.Abp.Core" Version="10.0.2" />
		<PackageVersion Include="Volo.Abp.Localization" Version="10.0.2" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
	</ItemGroup>
</Project>