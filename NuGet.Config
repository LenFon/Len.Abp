<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!--
		仓库级 NuGet 配置。

		本仓库启用了中央包管理（Directory.Packages.props）。中央包管理要求包版本只有
		一个来源，而继承自用户级/机器级的多个包源会让同一个包可能从不同源解析出不同
		结果，NuGet 因此报 NU1507。这里用 <clear /> 切断继承，只保留 nuget.org，
		再用包源映射把归属写死，保证本地与 CI 的还原结果一致。

		本仓库依赖的包全部来自 nuget.org。若将来确实需要引入其它源，请在本文件里
		显式添加该源，并在 packageSourceMapping 中为它登记对应的包 pattern——
		不要在用户级配置里追加，<clear /> 会把它清掉。
	-->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

	<packageSourceMapping>
		<clear />
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>

</configuration>
