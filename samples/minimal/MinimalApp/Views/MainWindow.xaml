<Window
    x:Class="MinimalApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:len="http://github.com/lenfon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewmodels="clr-namespace:MinimalApp.ViewModels"
    Title="Len.Abp 最小示例"
    Width="640"
    Height="420"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  导航按钮  -->
        <StackPanel Grid.Row="0" Margin="16">
            <StackPanel Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Command="{Binding ShowHelloCommand}"
                    Content="Hello" />
                <Button
                    MinWidth="120"
                    Margin="8,0,0,0"
                    Command="{Binding ShowGoodbyeCommand}"
                    Content="Goodbye" />
                <Button
                    MinWidth="120"
                    Margin="8,0,0,0"
                    Command="{Binding GoBackCommand}"
                    Content="回退" />
                <Button
                    MinWidth="120"
                    Margin="8,0,0,0"
                    Command="{Binding OpenGreetingCommand}"
                    Content="带参数问候">
                    <Button.CommandParameter>
                        <sys:Boolean>True</sys:Boolean>
                    </Button.CommandParameter>
                </Button>
                <Button
                    MinWidth="120"
                    Margin="8,0,0,0"
                    Command="{Binding OpenGreetingCommand}"
                    Content="缺参数问候">
                    <Button.CommandParameter>
                        <sys:Boolean>False</sys:Boolean>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="#888888"
                Text="{Binding Status}" />
        </StackPanel>

        <!--  区域宿主：导航把视图放进这里  -->
        <ContentControl
            x:Name="RegionHost"
            Grid.Row="1"
            Margin="16,0,16,16"
            len:RegionHost.Name="MainRegion" />
    </Grid>
</Window>
