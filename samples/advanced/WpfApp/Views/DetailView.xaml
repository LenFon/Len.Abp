<UserControl
    x:Class="WpfApp.Views.DetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:DetailViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Border
        Margin="12"
        Padding="16"
        Background="#F0F7FF"
        BorderBrush="#B9D7F5"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel>
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="详情页（声明了必需参数）" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="本视图在 [View] 上声明了 RequiredParameters = [&quot;id:int&quot;, &quot;source&quot;]，导航服务在激活之前校验；缺少参数时导航失败，界面保持原状。" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,4"
                    Text="id：" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{Binding Id}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,12,4"
                    Text="source：" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    Text="{Binding Source}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,12,4"
                    Text="进入次数：" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    Text="{Binding NavigatedToCount}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
