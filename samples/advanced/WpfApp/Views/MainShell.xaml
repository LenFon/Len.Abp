<controls:MetroWindow
    x:Class="WpfApp.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:len="http://github.com/lenfon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    Title="{Binding Title}"
    Width="1000"
    Height="700"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainShellViewModel}"
    FontFamily="{DynamicResource MahApps.Fonts.Family.Window.Title}"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    WindowTransitionsEnabled="False"
    mc:Ignorable="d">
    <!--
        MahApps 的 MetroWindow 用 WindowStyle=None 自绘标题栏，标题栏区域对系统是 HTCLIENT，
        拖动依赖托管代码补发 WM_NCLBUTTONDOWN。在 .NET 10 上这条路径不可靠（点击标题栏拖不动），
        显式挂 WindowChrome 让系统原生接管标题栏拖动与边框缩放。
        WindowChrome 会把整个标题栏高度当作非客户区，窗口按钮必须标记为可在 chrome 内命中，
        否则点击会被当作拖动标题栏，最小化/最大化/关闭全部失效。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="30"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <controls:MetroWindow.WindowButtonCommands>
        <controls:WindowButtonCommands WindowChrome.IsHitTestVisibleInChrome="True" />
    </controls:MetroWindow.WindowButtonCommands>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  导航栏  -->
        <Border
            Grid.Column="0"
            Background="#F5F5F7"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock
                    Margin="4,4,0,12"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="生成器示例" />

                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowGalleryCommand}"
                    Content="控件画廊" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowSingletonCommand}"
                    Content="单例视图" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowTransientCommand}"
                    Content="瞬态视图" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowScopedCommand}"
                    Content="作用域视图" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowSharedStateCommand}"
                    Content="视图瞬态 + 视图模型单例" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowNestedRegionCommand}"
                    Content="嵌套区域（8 层）" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowRegionsCommand}"
                    Content="区域适配器与导航" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowDemoCommand}"
                    Content="导航示例" />
                <Button
                    Margin="0,0,0,6"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowLoginCommand}"
                    Content="登录界面" />

                <Separator Margin="0,12,0,12" />

                <TextBlock
                    Margin="4,0,0,4"
                    FontSize="12"
                    Foreground="#888888"
                    Text="当前视图" />
                <TextBlock
                    Margin="4,0,0,8"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentViewName}" />
                <TextBlock
                    Margin="4,0,0,0"
                    FontSize="12"
                    Foreground="#888888"
                    Text="{Binding NavigationStatus}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  区域宿主  -->
        <ContentControl
            x:Name="RegionHost"
            Grid.Column="1"
            len:RegionHost.Name="MainRegion" />
    </Grid>
</controls:MetroWindow>
