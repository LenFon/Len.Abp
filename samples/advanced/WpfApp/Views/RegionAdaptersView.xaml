<UserControl
    x:Class="WpfApp.Views.RegionAdaptersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:len="http://github.com/lenfon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:RegionAdaptersViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="880">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="22"
                FontWeight="Bold"
                Text="区域适配器与导航能力" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="#666666"
                Text="下面演示 TabControl / ItemsControl 两种区域适配器、导航历史回退、必需参数校验与取消。" />

            <!--  TabControl 区域  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="1. TabControl 区域（单活动视图）" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="每个视图一个选项卡，SelectedItem 与激活双向同步。选项卡标题来自视图上的 RegionHost.TabHeader。" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="tab-page-1"
                            Content="选项卡一" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="tab-page-2"
                            Content="选项卡二" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="tab-page-3"
                            Content="选项卡三" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding GoBackTabCommand}"
                            Content="回退" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding OpenDetailWithParametersCommand}"
                            Content="带参数打开详情" />
                        <Button
                            Command="{Binding OpenDetailWithoutParametersCommand}"
                            Content="缺参数打开详情" />
                    </StackPanel>

                    <TabControl
                        MinHeight="150"
                        len:RegionHost.Name="TabRegion" />
                </StackPanel>
            </Border>

            <!--  ItemsControl 区域  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="2. ItemsControl 区域（多活动视图）" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="所有视图同时显示，与激活状态无关。多活动区域不会被导航自动失活，需要回收时显式调用 RemoveAll。" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding AddListItemCommand}"
                            CommandParameter="list-page-1"
                            Content="追加列表项一" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding AddListItemCommand}"
                            CommandParameter="list-page-2"
                            Content="追加列表项二" />
                        <Button
                            Command="{Binding ClearListCommand}"
                            Content="说明：如何清空" />
                    </StackPanel>

                    <ItemsControl len:RegionHost.Name="ListRegion" />
                </StackPanel>
            </Border>

            <!--  自定义 ListBox 区域  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="3. 自定义 ListBox 区域（单活动视图）" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="继承 BasicRegionAdapter&lt;ListBox&gt; 并按键控方式注册，RegionAdapterFinder 沿继承链命中它。列表项显示全部视图，只有选中项处于激活状态。" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ShowListBoxItemCommand}"
                            CommandParameter="tab-page-1"
                            Content="列表项一" />
                        <Button
                            Command="{Binding ShowListBoxItemCommand}"
                            CommandParameter="tab-page-2"
                            Content="列表项二" />
                    </StackPanel>

                    <ListBox
                        MinHeight="90"
                        len:RegionHost.Name="ListBoxRegion" />
                </StackPanel>
            </Border>

            <!--  取消  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="4. 取消与失败诊断" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="取消是唯一不会被包装成失败结果的异常；参数校验失败与区域不存在都返回失败结果，异常消息说明原因。" />

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding NavigateWithCancelCommand}"
                            Content="发起一次已取消的导航" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding Status}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  全局异常处理  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="5. 自定义全局异常处理" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="WpfAppExceptionHandler 替换了框架默认的 IWpfExceptionHandler：异常除写日志外还会弹窗并记入下方列表。点按钮在 UI 线程抛异常，进程不会退出。" />

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ThrowUiExceptionCommand}"
                            Content="在 UI 线程抛异常" />
                        <Button
                            Command="{Binding ClearExceptionLogCommand}"
                            Content="清空异常记录" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ExceptionLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="#B03030"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  操作日志  -->
            <Border
                Padding="16"
                Background="#1E1E1E"
                CornerRadius="6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button
                            DockPanel.Dock="Right"
                            Command="{Binding ClearActivityLogCommand}"
                            Content="清空" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="操作日志" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="#B0E0B0"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
