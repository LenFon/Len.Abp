<UserControl
    x:Class="WpfApp.Views.ControlsGalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wc="http://github.com/lenfon/wpfapp/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ControlsGalleryViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="880">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="22"
                FontWeight="Bold"
                Text="生成器控件画廊" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="#666666"
                Text="下面三个控件全部由源生成器产出依赖属性、附加属性与路由事件，代码里没有一行 DependencyProperty.Register 或 EventManager.RegisterRoutedEvent。" />

            <!--  依赖属性 + 路由事件  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="1. RatingControl：依赖属性与三种路由策略" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="Rating 是双向绑定的可读写属性，DisplayText 是只读属性；IsRatingValid 拒绝负数，CoerceRating 把值收敛到 0-5。" />

                    <wc:RatingControl
                        Caption="{Binding RatingCaption}"
                        PreviewRatingChanged="OnPreviewRatingChanged"
                        Rating="{Binding Rating, Mode=TwoWay}"
                        RatingChanged="OnRatingChanged"
                        RatingCommitted="OnRatingCommitted" />

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="标题：" />
                        <TextBox
                            Width="160"
                            Margin="4,0,0,0"
                            Text="{Binding RatingCaption, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="评分：" />
                        <TextBox
                            Width="60"
                            Margin="4,0,0,0"
                            Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ResetRatingCommand}"
                            Content="重置" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#888888"
                            Text="输入 200 会被校验拒绝；输入 9 会被强制值收敛到 5。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  附加依赖属性 + 附加路由事件  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="2. TagInput：附加依赖属性与附加路由事件" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="Tags、MaxTagLength、AllowDuplicates、TagPadding 是附加属性，TagCount 是只读附加属性；TagAdded 与 TagRejected 是附加路由事件。" />

                    <wc:TagInput
                        wc:TagInputAssist.AllowDuplicates="{Binding AllowDuplicateTags}"
                        wc:TagInputAssist.MaxTagLength="{Binding MaxTagLength}"
                        wc:TagInputAssist.TagAdded="OnTagAdded"
                        wc:TagInputAssist.TagRejected="OnTagRejected"
                        Placeholder="{Binding TagPlaceholder}" />

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="允许重复标签"
                            IsChecked="{Binding AllowDuplicateTags}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="最大长度：" />
                        <TextBox
                            Width="60"
                            Margin="4,0,0,0"
                            Text="{Binding MaxTagLength, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#888888"
                            Text="超过最大长度或重复的标签会触发 TagRejected。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  非控件宿主上的附加成员  -->
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="3. InteractionAssist：非控件宿主承载附加成员" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="#888888"
                        Text="IsBusy、BusyOpacity、BusyText 是附加属性，DoubleClick 是附加路由事件。宿主不是控件，只是一个派生自 DependencyObject 的普通类。" />

                    <Border
                        x:Name="DoubleClickArea"
                        Height="90"
                        Background="#EEF2FF"
                        BorderBrush="#C7D2FE"
                        BorderThickness="1"
                        CornerRadius="4"
                        wc:InteractionAssist.BusyOpacity="{Binding BusyOpacity}"
                        wc:InteractionAssist.BusyText="{Binding BusyText}"
                        wc:InteractionAssist.DoubleClick="OnDoubleClick"
                        wc:InteractionAssist.IsBusy="{Binding IsBusy}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding DoubleClickHint}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#888888"
                                Text="{Binding BusyText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ToggleBusyCommand}"
                            Content="切换忙碌状态" />
                        <TextBlock VerticalAlignment="Center" Text="透明度：" />
                        <Slider
                            Width="160"
                            Margin="4,0,0,0"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding BusyOpacity}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  事件日志  -->
            <Border
                Padding="16"
                Background="#1E1E1E"
                CornerRadius="6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button
                            DockPanel.Dock="Right"
                            Command="{Binding ClearLogsCommand}"
                            Content="清空" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="事件日志" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="#B0E0B0"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
