<UserControl x:Class="WpfApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- 背景深色蒙层 -->
    <Grid Background="#1E1E1E">
        <!-- 玻璃效果登录面板 -->
        <Border Width="350" Height="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="10"
                Opacity="0.9">
            <!-- 玻璃效果背景（毛玻璃+渐变） -->
            <Border.Background>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Grid>
                            <Rectangle Fill="#2C2C2C" Opacity="0.5"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3A3A3A" Offset="0"/>
                                        <GradientStop Color="#2C2C2C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>

            <!-- 发光边框效果 -->
            <Border.Effect>
                <DropShadowEffect Color="#00A2FF"
                                  BlurRadius="20"
                                  Opacity="0.8"
                                  Direction="0"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <!-- 标题 -->
                    <RowDefinition Height="50"/>
                    <!-- 用户名 -->
                    <RowDefinition Height="50"/>
                    <!-- 密码 -->
                    <RowDefinition Height="40"/>
                    <!-- 记住我/忘记密码 -->
                    <RowDefinition Height="50"/>
                    <!-- 登录按钮 -->
                </Grid.RowDefinitions>

                <!-- 标题区域 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="欢迎回来" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                    <TextBlock Text="请输入账号密码登录" FontSize="12" Foreground="#AAAAAA"/>
                </StackPanel>

                <!-- 用户名输入框 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Border CornerRadius="5" Background="#3A3A3A" Opacity="0.8">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="User" Width="18" Height="18" Foreground="#00A2FF"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="14" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 密码输入框（带显示/隐藏按钮） -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Border CornerRadius="5" Background="#3A3A3A" Opacity="0.8">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Lock" Width="18" Height="18" Foreground="#00A2FF"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="pwdBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" PasswordChar="●"/>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                     ToolTip="显示密码">
                                <materialDesign:PackIcon x:Name="iconPwd" Kind="Eye" Width="18" Height="18"
                                                         Foreground="#AAAAAA"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 记住我 & 忘记密码 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    <CheckBox Content="记住我" Foreground="#AAAAAA" FontSize="12"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="忘记密码" Foreground="#00A2FF" FontSize="12"
                               HorizontalAlignment="Right" Cursor="Hand" Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 登录按钮 -->
                <Button Grid.Row="4" Content="登录" Background="#00A2FF" Foreground="White"
                        FontSize="16" FontWeight="Bold" BorderThickness="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Effect>
                        <DropShadowEffect Color="#00A2FF" BlurRadius="10" Opacity="0.5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>

        <!-- 关闭按钮 -->
        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0" Background="Transparent" BorderThickness="0"
                >
            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#AAAAAA"/>
        </Button>
    </Grid>
</UserControl>
