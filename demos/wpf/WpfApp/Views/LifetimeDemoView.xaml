<UserControl
    x:Class="WpfApp.Views.LifetimeDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LifetimeDemoViewModelBase}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="16">
        <TextBlock
            x:Name="TitleText"
            Margin="0,0,0,4"
            FontSize="20"
            FontWeight="Bold" />
        <TextBlock
            x:Name="LifetimeText"
            Margin="0,0,0,12"
            Foreground="#666666" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,12,4"
                Text="视图模型实例编号：" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Text="{Binding InstanceId}" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,12,4"
                Text="创建时间：" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,4"
                Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss.fff}}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,12,4"
                Text="进入次数：" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,0,4"
                Text="{Binding NavigatedToCount}" />

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,12,4"
                Text="导航参数：" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,0,0,4"
                Text="{Binding NavigationParameters}" />
        </Grid>

        <TextBlock
            Margin="0,16,0,4"
            FontWeight="SemiBold"
            Text="导航回调记录" />
        <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#444444"
                        Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
