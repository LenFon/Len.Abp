<UserControl
    x:Class="WpfApp.Views.NestedRegionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:len="http://github.com/lenfon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:NestedRegionViewModelBase}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!--  八层嵌套叠加后高度会超过窗口，外层滚动保证任何窗口尺寸下都能看全  -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!--  本层信息条：层级、实例编号、进入次数与操作按钮压在一行  -->
            <Border
                Padding="8,5"
                Background="#F5F5F7"
                CornerRadius="4">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Command="{Binding EnterNextCommand}"
                            Content="进入下一层"
                            FontSize="11"
                            Visibility="{Binding HasChild, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Command="{Binding SwitchChildCommand}"
                            Content="切换子区域视图"
                            FontSize="11"
                            Visibility="{Binding HasChild, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            Margin="0,0,6,0"
                            Padding="8,2"
                            Command="{Binding ExitCommand}"
                            Content="退出到画廊"
                            FontSize="11" />
                        <Button
                            Padding="8,2"
                            Command="{Binding CollectStatsCommand}"
                            Content="统计实例存活"
                            FontSize="11" />
                    </StackPanel>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="TitleText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#666666"
                            Text="{Binding InstanceId, StringFormat=实例 #{0}}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#666666"
                            Text="{Binding NavigatedToCount, StringFormat=进入 {0} 次}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock
                Margin="8,3,0,0"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="#444444"
                Text="{Binding InstanceStats}"
                TextWrapping="Wrap" />

            <!--  子区域：左侧竖线表示嵌套层级，内容由下一层视图填充  -->
            <Border
                Margin="0,4,0,0"
                BorderBrush="#D8D8DE"
                BorderThickness="2,0,0,0"
                Visibility="{Binding HasChild, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl x:Name="ChildRegionHost" Margin="8,0,0,0" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
