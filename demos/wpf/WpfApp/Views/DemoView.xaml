<UserControl
    x:Class="WpfApp.Views.DemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:len="http://github.com/lenfon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfApp.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:DemoViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,30"
            FontSize="24"
            FontWeight="Bold"
            Text="{Binding Message}" />
        <Button Command="{Binding ClickCommand}" Content="Click Me" />
        <ContentControl len:Navigation.RegionName="DemoRegion" />
    </StackPanel>
</UserControl>