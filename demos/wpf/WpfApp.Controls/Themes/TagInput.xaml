<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wc="clr-namespace:WpfApp.Controls">

    <Style TargetType="{x:Type wc:TagInput}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wc:TagInput}">
                    <Border
                        Padding="8"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Tags, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="8,2"
                                            Background="#EEF2FF"
                                            CornerRadius="10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                <Button
                                                    Width="16"
                                                    Height="16"
                                                    Margin="4,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="×"
                                                    Cursor="Hand"
                                                    Focusable="False"
                                                    Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBox
                                    x:Name="PART_InputBox"
                                    BorderThickness="0"
                                    Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    x:Name="PART_Placeholder"
                                    VerticalAlignment="Center"
                                    Foreground="#AAAAAA"
                                    IsHitTestVisible="False" />
                            </Grid>
                            <!--  只读附加属性 TagCount 由控件内部维护，模板只负责显示。  -->
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#888888"
                                    Text="标签数量：" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#888888"
                                    Text="{Binding Path=(wc:TagInputAssist.TagCount), RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
